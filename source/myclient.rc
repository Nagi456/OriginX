    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "OriginX"
            VALUE "FileDescription", "OriginX Client"
            VALUE "ProductName", "OriginX Client"
            VALUE "FileVersion", "0.5.0"
            VALUE "ProductVersion", "0.5.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
